{
  "name": "parastream",
  "version": "0.0.1",
  "description": "Normalize AI stream protocols and segment incremental text.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/clean-dist.ts && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test ./tests",
    "check": "bun run typecheck && bun test ./tests"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
