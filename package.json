{
  "name": "paratoken",
  "version": "0.1.0",
  "description": "Normalize AI stream protocols and segment incremental text.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshleyJackson/paratoken.git"
  },
  "homepage": "https://github.com/AshleyJackson/paratoken#readme",
  "bugs": {
    "url": "https://github.com/AshleyJackson/paratoken/issues"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run scripts/clean-dist.ts && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "bun test ./tests/assembler.test.ts ./tests/protocols.test.ts ./tests/provider-fixtures.test.ts ./tests/segment.test.ts ./tests/transports.test.ts ./tests/web-streams.test.ts",
    "test:visual": "bun test ./tests/visual-stream.test.ts",
    "test": "bun run test:unit && bun run test:visual",
    "check": "bun run typecheck && bun run test:unit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
